    "react-dom": "^19.1.1",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "sass-embedded": "^1.92.1",
    "typescript": "^7.0.2",
